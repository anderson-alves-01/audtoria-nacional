# Local environment. Restricted municipal PII is forbidden.
# PUBLIC_OPEN official extracts may populate Landing/Bronze/Silver/Gold.
# Synthetic fixtures are test-only (SIRTA_ALLOW_SYNTHETIC_LOADS).

SIRTA_ENV=local
SIRTA_IMPLEMENTATION_VERSION=0.3.1
SIRTA_SPEC_VERSION=0.3.0

DATABASE_URL=postgresql+psycopg://sirta:sirta_local_only@localhost:55432/sirta
REDIS_URL=redis://localhost:6379/0

OIDC_ISSUER=http://localhost:8081/realms/sirta
OIDC_AUDIENCE=sirta-api
OIDC_JWKS_URL=http://localhost:8081/realms/sirta/protocol/openid-connect/certs

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sirta
S3_SECRET_KEY=sirta_local_only
S3_BUCKET=sirta-local
S3_REGION=local

POSTGRES_USER=sirta
POSTGRES_PASSWORD=sirta_local_only
POSTGRES_DB=sirta

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_only
MINIO_ROOT_USER=sirta
MINIO_ROOT_PASSWORD=sirta_local_only
