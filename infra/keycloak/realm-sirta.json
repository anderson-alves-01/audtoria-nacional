{
  "id": "sirta",
  "realm": "sirta",
  "enabled": true,
  "displayName": "SIRTA Local",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      { "name": "analyst", "description": "Fiscal analyst" },
      { "name": "validator", "description": "Credit validator" },
      { "name": "tech_admin", "description": "Technical administrator without fiscal content" }
    ]
  },
  "clients": [
    {
      "clientId": "sirta-api",
      "name": "SIRTA API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "sirta_api_local_only",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "bearerOnly": false
    },
    {
      "clientId": "sirta-web",
      "name": "SIRTA Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "analyst.alpha",
      "enabled": true,
      "email": "analyst.alpha@synthetic.local",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Lista",
      "credentials": [{ "type": "password", "value": "synthetic", "temporary": false }],
      "realmRoles": ["analyst"],
      "attributes": {
        "tenant_id": ["11111111-1111-4111-8111-111111111111"]
      }
    },
    {
      "username": "validator.alpha",
      "enabled": true,
      "email": "validator.alpha@synthetic.local",
      "emailVerified": true,
      "firstName": "Val",
      "lastName": "Idator",
      "credentials": [{ "type": "password", "value": "synthetic", "temporary": false }],
      "realmRoles": ["validator"],
      "attributes": {
        "tenant_id": ["11111111-1111-4111-8111-111111111111"]
      }
    },
    {
      "username": "admin.alpha",
      "enabled": true,
      "email": "admin.alpha@synthetic.local",
      "emailVerified": true,
      "firstName": "Tec",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "synthetic", "temporary": false }],
      "realmRoles": ["tech_admin"],
      "attributes": {
        "tenant_id": ["11111111-1111-4111-8111-111111111111"]
      }
    },
    {
      "username": "analyst.beta",
      "enabled": true,
      "email": "analyst.beta@synthetic.local",
      "emailVerified": true,
      "firstName": "Bia",
      "lastName": "Eta",
      "credentials": [{ "type": "password", "value": "synthetic", "temporary": false }],
      "realmRoles": ["analyst"],
      "attributes": {
        "tenant_id": ["22222222-2222-4222-8222-222222222222"]
      }
    }
  ]
}
